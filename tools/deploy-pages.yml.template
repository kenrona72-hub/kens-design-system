# Canonical GitHub Pages deploy workflow for Ken's static sites.
#
# Copy this file into a new repo as .github/workflows/deploy-pages.yml
# and adjust the two spots marked below. Then, before the first deploy
# will actually work, do this ONCE per repo (both are manual GitHub UI
# steps — the Actions bot token cannot do either via API):
#
#   1. Settings -> General -> Danger Zone -> make the repo public.
#      (GitHub Pages is not available for private repos on the free plan.)
#   2. Settings -> Pages -> Build and deployment -> Source -> "GitHub Actions".
#      (Without this, "Configure Pages" fails even with enablement: true —
#      the bot token can't create a repo's first-ever Pages site itself.)
#
# Also: workflow_dispatch only becomes callable via the API once this file
# exists on the repo's DEFAULT branch (usually main) — not a feature branch.
# So for a brand-new repo, push this workflow to main first.

name: Deploy to GitHub Pages

on:
  push:
    branches:
      - main
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: false

jobs:
  deploy:
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      # --- If this site needs a build step (Vite, etc.), add it here ---
      # - name: Install dependencies
      #   run: npm ci
      # - name: Build
      #   run: npm run build:demo

      - name: Configure Pages
        uses: actions/configure-pages@v5
        with:
          enablement: true

      - name: Upload site as Pages artifact
        uses: actions/upload-pages-artifact@v3
        with:
          # Plain static site: use "." (repo root).
          # Built site: point at the build output dir, e.g. "./demo-dist".
          path: .

      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4
